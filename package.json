{
  "name": "pixelpeek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PixelPeek — inspect and recreate the visual design of any website.",
  "scripts": {
    "dev": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts",
    "check": "npm run typecheck && npm run test && npm run build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
